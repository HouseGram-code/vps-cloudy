# Discord bot token — get it from https://discord.com/developers/applications
DISCORD_TOKEN=

# Default VPS spec (Docker resource limits)
DEFAULT_RAM=8g
DEFAULT_CPU=1
DEFAULT_DISK=10g

# How many days a new VPS lives before it expires
LIFETIME_DAYS=15

# Display name for this node (shown in embeds)
NODE_NAME=Local Node

# Container name prefix — becomes "<prefix>-<user_id>-vps-<n>"
OWNER_PREFIX=tbmen12

# Comma-separated Discord user IDs allowed to use admin commands
ADMIN_IDS=
