# Discord bot token — DO NOT commit the real token to GitHub.
# Copy this file to .env on your server and paste your token there.
DISCORD_TOKEN=PASTE_YOUR_TOKEN_HERE

# VPS / LXC settings
NODE_NAME=Local Node
OWNER_PREFIX=tbmen12
DEFAULT_RAM=4GB
DEFAULT_CPU=8
DEFAULT_DISK=85GB
LIFETIME_DAYS=30

# LXC socket (uncomment + adjust for your LXD install)
# Snap LXD:  LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
# Deb LXD:   LXD_SOCKET=/var/lib/lxd/unix.socket
